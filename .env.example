# DevHQ environment template.
#
# Single source of truth: docs/agents/WAVE4.md §4. `make secrets` copies this
# file to .env (mode 0600) and records DEVHQ_SECRETS_GID. Never commit .env.
#
# Two consumers read these names:
#   1. docker compose: interpolates ${VARS} in docker-compose*.yml from .env.
#   2. A bare-metal `npm run dev` in Backend/ (export them in your shell; the
#      backend does not load .env itself).
#
# SECRETS DO NOT GO HERE. In Docker they are files in infra/secrets/ mounted at
# /run/secrets/<name> and exposed to the app as <VAR>_FILE (see
# infra/docker/entrypoint.sh). The secret variables below are listed, commented
# out, only so the full contract is visible and for bare-metal development.

# ---------------------------------------------------------------------------
# Deployment (compose interpolation only)
# ---------------------------------------------------------------------------
# Public host name. "localhost" makes Caddy issue certs from its internal CA.
DEVHQ_DOMAIN=localhost
# ACME (Let's Encrypt) account contact; required for a real domain.
ACME_EMAIL=admin@example.com
# Image coordinates. CI pushes ghcr.io/<owner>/<repo>-{edge,frontend,backend,models}.
DEVHQ_IMAGE_PREFIX=ghcr.io/devhq/devhq
DEVHQ_TAG=local
# Group allowed to read infra/secrets/* (written by `make secrets`).
DEVHQ_SECRETS_GID=10001
# Edge listeners. EDGE_BIND=127.0.0.1 keeps a dev box off the LAN.
EDGE_BIND=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_MAX_BODY_SIZE=2MB
# Optional public host for S3 presigned URLs (infra/edge/sites/objects.caddy.example).
S3_PUBLIC_HOST=
# Dev only: weakens HSTS so localhost is not pinned. Leave unset in production.
# HSTS_VALUE=max-age=0

# ---------------------------------------------------------------------------
# Backend core (existing)
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
# Compose derives APP_ORIGIN / PUBLIC_URL / WEBAUTHN_RP_ID from DEVHQ_DOMAIN.
# Set them explicitly only for bare-metal runs.
# APP_ORIGIN=https://devhq.example.com
# PUBLIC_URL=https://devhq.example.com
# WEBAUTHN_RP_ID=devhq.example.com
WEBAUTHN_RP_NAME=DevHQ
# Extra comma-separated origins allowed for credentialed calls.
CORS_ORIGINS=
# 1 = trust the first X-Forwarded-For hop. Only true behind the edge, which
# overwrites any client-supplied value. Compose sets it for the backend.
TRUST_PROXY=1
LOG_LEVEL=info

# SESSION_SECRET            -> infra/secrets/session_secret (>= 64 hex chars in prod)
# SESSION_SECRET_PREVIOUS   -> infra/secrets/session_secret_previous (rotation window)

# ---------------------------------------------------------------------------
# SEC: encryption at rest
# ---------------------------------------------------------------------------
# DATA_ENCRYPTION_KEY       -> infra/secrets/data_encryption_key (32-byte hex, AES-256-GCM)

# ---------------------------------------------------------------------------
# B-DATA: PostgreSQL
# ---------------------------------------------------------------------------
# DATABASE_URL              -> infra/secrets/database_url
#                              postgres://devhq:<password>@postgres:5432/devhq
# Postgres runs on an internal Docker network; set true for a managed DB.
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# STORAGE + ML: S3-compatible object storage (MinIO locally)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_UPLOADS=devhq-uploads
S3_BUCKET_BACKUPS=devhq-backups
S3_BUCKET_AUDIT=devhq-audit
S3_BUCKET_MODELS=devhq-models
# S3_ACCESS_KEY_ID          -> infra/secrets/s3_access_key_id
# S3_SECRET_ACCESS_KEY      -> infra/secrets/s3_secret_access_key

# ---------------------------------------------------------------------------
# ML: Python service (internal only)
# ---------------------------------------------------------------------------
ML_SERVICE_URL=http://models:8000
# ML_SERVICE_TOKEN          -> infra/secrets/ml_service_token (HMAC shared secret)
# ANTHROPIC_API_KEY         -> infra/secrets/anthropic_api_key (models only; never the browser)
ASSISTANT_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------------------
# B-COLLAB: mail
# ---------------------------------------------------------------------------
# resend | smtp | console (console prints mail to the log; default).
# Production email goes through Resend: docs/operations/email.md
MAIL_TRANSPORT=console
MAIL_FROM="DevHQ <no-reply@mail.example.com>"
# MAIL_REPLY_TO=support@example.com
# RESEND_API_KEY            -> infra/secrets/resend_api_key (required when MAIL_TRANSPORT=resend in production)
# RESEND_TIMEOUT_MS=10000                         # per attempt; one retry on 429/5xx
# APP_URL=https://app.example.com                 # base of email links (default APP_ORIGIN)
# Brand shown in every email (https URLs required in production)
# BRAND_NAME=DevHQ
# BRAND_LEGAL_NAME="DevHQ Technologies Ltd"
# BRAND_LOGO_URL=https://example.com/email/logo.png  # PNG, about 2x the display width
# BRAND_LOGO_WIDTH=120
# BRAND_PRIMARY_COLOR=#4f46e5
# BRAND_ACCENT_COLOR=#0e7490
# BRAND_SUPPORT_EMAIL=support@example.com
# BRAND_POSTAL_ADDRESS="1 Example Street, Example City, EX 00000"
# BRAND_WEBSITE_URL=https://example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM="DevHQ <no-reply@example.com>"
# SMTP_PASSWORD             -> infra/secrets/smtp_password

# ---------------------------------------------------------------------------
# B-DOMAIN: GitHub App (demo fallback when unset)
# ---------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
# GITHUB_APP_PRIVATE_KEY    -> infra/secrets/github_app_private_key (PEM)
# GITHUB_WEBHOOK_SECRET     -> infra/secrets/github_webhook_secret
# GITHUB_CLIENT_SECRET      -> infra/secrets/github_client_secret
# GITHUB_TOKEN              -> infra/secrets/github_token

# ---------------------------------------------------------------------------
# Demo mode (existing; never enabled when NODE_ENV=production)
# ---------------------------------------------------------------------------
DEMO_DISABLED=1
# DEMO_PASSWORD / DEMO_MFA_CODE / DEMO_TOTP_SECRET: development only.

# ---------------------------------------------------------------------------
# Optional tuning added by the Wave 4 lanes (defaults shown; leave commented
# unless you need to change them)
# ---------------------------------------------------------------------------
# Database (B-DATA)
# DATABASE_SSL_CA=/run/secrets/database_ca.pem   # PEM path, used with DATABASE_SSL=verify-full
# DATABASE_MIGRATION_URL                          -> secret file; owner role for `migrate` only
# Encryption key rotation (SEC)
# DATA_ENCRYPTION_KEYS_PREVIOUS                   -> secret file; comma-separated old 64-hex keys
# WEBAUTHN_ALGORITHMS=-7,-257                      # subset of -7 (ES256), -8 (EdDSA), -257 (RS256)
# Object storage (STORAGE)
# S3_PUBLIC_ENDPOINT=https://objects.example.com   # browser-reachable host used to sign presigned URLs
# S3_ALLOW_HTTP=0                                  # 1 = allow plain-http S3 on a private network in prod
# STORAGE_LOCAL_DIR=./.backups/object-store        # local driver only (no S3_ENDPOINT)
# STORAGE_LOCAL_PORT=0                             # local driver's 127.0.0.1 presign listener
# Mail and realtime (B-COLLAB)
# SMTP_REQUIRE_TLS=1                               # 0 only for a local test relay
# MAIL_DIGEST_MINUTES=                             # unset = notification email digest off
# STREAM_HEARTBEAT_MS=15000                        # /api/stream SSE heartbeat
# Runtime paths / metadata
# BACKUP_DIR=./.backups
# AUDIT_LOG_FILE=./.audit/audit.jsonl
# APP_VERSION=1.4.0
# Object storage hardening (minio-init)
# MINIO_ENABLE_SSE=0      # 1 in production, after configuring a MinIO KMS key
# STORAGE_LOCK_MODE=GOVERNANCE   # COMPLIANCE in production (irreversible WORM retention); R2_BUCKET_LOCK on Cloudflare R2
# Periodic jobs (Backend/lib/jobs.ts, Backend/worker.ts)
# JOBS_IN_PROCESS=1              # 1 = all | 0 = none | list of backup,monitors,digest
# WORKER_JOBS=1                  # jobs of the long-running worker.ts (same syntax)
# WORKER_LOOP_ENABLED=0          # 1 allows the long-running worker in production (phase 2 only)
# Shared runtime state (Backend/lib/redis.ts, ADR 0009)
# REDIS_URL=                     # redis://… or rediss://… (TLS); unset = per-process limits, bus and job leases
# REDIS_KEY_PREFIX=devhq:        # namespace for keys and channels
# REDIS_COMMAND_TIMEOUT_MS=500   # slower = Redis down (api limiter falls back, auth limiters 503, jobs skip)
# EXPECT_REPLICAS=1              # >1 makes Redis mandatory (boot refusal, readiness)
