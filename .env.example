# DevHQ Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env or any file with real secrets

# Application
NODE_ENV=development
APP_NAME=DevHQ
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Backend
BACKEND_PORT=8080
BACKEND_HOST=0.0.0.0
BACKEND_PUBLIC_URL=http://localhost:8080

# Frontend
FRONTEND_PORT=3000
FRONTEND_HOST=0.0.0.0

# Database (if using external DB)
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRY=24h
SESSION_SECRET=your-super-secret-session-key-change-this

# OAuth Providers (optional)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# API Keys (for external services)
OPENAI_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Monitoring & Analytics
SENTRY_DSN=
ANALYTICS_ID=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@devhq.com

# Redis (if using for caching)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# Feature Flags
FEATURE_AUTH=true
FEATURE_ML_MODELS=false
FEATURE_AUDIT_LOGGING=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
CORS_ORIGIN=http://localhost:3000
HELMET_ENABLED=true
SECURE_COOKIES=true

# ML Models
MODEL_PATH=./Models/models
DATA_PATH=./Models/data

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
