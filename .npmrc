# TavetaHQ npm configuration
# https://docs.npmjs.com/cli/configuring-npm/npmrc
#
# Security posture: dependency lifecycle scripts are disabled, transport is
# TLS-verified, and audits run at high severity. Anything relaxed here must be
# justified in review.

# ---------------------------------------------------------------------------
# Registry transport security
# ---------------------------------------------------------------------------
strict-ssl=true
registry=https://registry.npmjs.org/

# ---------------------------------------------------------------------------
# Install safety
# ---------------------------------------------------------------------------
# Never execute lifecycle scripts from dependencies. Malicious postinstall
# scripts are the most common npm supply-chain compromise vector (they run with
# the developer's full privileges and can exfiltrate tokens and SSH keys).
#
# Consequence: `prepare`/`postinstall` hooks do NOT run automatically, so git
# hooks must be installed explicitly:  npm run hooks:install
ignore-scripts=true

# Refuse installation when the running Node/npm does not satisfy `engines`.
# Left disabled so a single over-narrow transitive range cannot block the whole
# workspace install; CI enforces the real Node version via its matrix.
engine-strict=false

# ---------------------------------------------------------------------------
# Dependency determinism
# ---------------------------------------------------------------------------
# Record exact versions so a later resolve cannot silently drift.
save-exact=true
package-lock=true

# ---------------------------------------------------------------------------
# Vulnerability auditing
# ---------------------------------------------------------------------------
audit=true
audit-level=high
fund=false

# ---------------------------------------------------------------------------
# Network and output
# ---------------------------------------------------------------------------
maxsockets=50
progress=false
loglevel=warn

# ---------------------------------------------------------------------------
# Private scope registry (uncomment when publishing @devhq/*)
# ---------------------------------------------------------------------------
# @devhq:registry=https://npm.pkg.github.com/
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
