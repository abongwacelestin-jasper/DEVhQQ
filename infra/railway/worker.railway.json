{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Backend/Dockerfile",
    "watchPatterns": [
      "/Backend/**",
      "/infra/docker/entrypoint.sh",
      "/package.json",
      "/package-lock.json",
      "/.npmrc",
      "/infra/railway/worker.railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node --experimental-strip-types --disable-warning=ExperimentalWarning worker.ts",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "drainingSeconds": 15,
    "sleepApplication": false
  }
}
