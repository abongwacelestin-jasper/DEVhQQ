# TavetaHQ brand for transactional email. Every value here is OPTIONAL: when one
# is unset, the backend derives it from the app's own address (APP_URL, else
# APP_ORIGIN), so emails look complete with no BRAND_* configuration at all.
# Set a value only where yours differs from the default shown above it; then
# load these into Railway (backend + worker) or export them before
# `infra/railway/setup.sh`. Lines marked REVIEW need a real-world value only
# you can supply. Full reference: docs/operations/email.md#brand-variables.
#
# "Registrable domain" = the app host without subdomains:
# app.example.com -> example.com, app.example.co.uk -> example.co.uk;
# localhost -> devhq.local (never receives mail).

# Base of every link and the source of every default below.
# The platform's official domain.
APP_URL=https://tavetahq.io

# Default: TavetaHQ. Shown in subjects, headings and the "From" display name.
BRAND_NAME=TavetaHQ

# Default: BRAND_NAME (TavetaHQ).
# REVIEW: your registered company name for the email footer (e.g. "TavetaHQ Ltd").
BRAND_LEGAL_NAME=TavetaHQ

# Default: <app origin>/brand/tavetahq-email-logo.png, the lockup PNG the frontend
# serves from Frontend/public/brand/. Set only to host the logo elsewhere.
BRAND_LOGO_URL=https://tavetahq.io/brand/tavetahq-email-logo.png
# Default: 168 (display width in px; the PNG is 336 px wide, sharp on retina).
BRAND_LOGO_WIDTH=168

# Default: <app origin>/brand. Email heroes and product marks are served from
# <base>/email/... (Frontend/public/brand/email/). Set only for a CDN.
# BRAND_ASSET_BASE_URL=https://cdn.example.com/brand

# Defaults: Taveta Indigo (buttons) and deep indigo (links, highlights).
BRAND_PRIMARY_COLOR=#4338ca
BRAND_ACCENT_COLOR=#3730a3

# Default: support@<registrable domain>. Footer "Help" and "Questions?" links.
# REVIEW: must be a monitored mailbox.
BRAND_SUPPORT_EMAIL=support@tavetahq.io
# Default: the app origin.
BRAND_WEBSITE_URL=https://tavetahq.io

# No default, never invented: a postal address in an email footer is a legal
# statement. While it is empty the footer omits the line and production logs a
# warning. REVIEW (required before sending at scale): a real address you control.
BRAND_POSTAL_ADDRESS=

# Sending identity. Send from a dedicated subdomain so marketing or personal mail
# on the root domain never affects transactional reputation.
# Default (console/smtp): "<BRAND_NAME> <no-reply@<registrable domain>>".
# MAIL_TRANSPORT=resend in production REQUIRES it explicitly, because its domain
# must be verified in Resend.
# REVIEW: verify mail.tavetahq.io in Resend before the first live send.
MAIL_FROM="TavetaHQ <no-reply@mail.tavetahq.io>"
# Default: the support address.
MAIL_REPLY_TO=support@tavetahq.io
