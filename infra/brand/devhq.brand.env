# DevHQ brand for transactional email. Proposed from the platform's own identity
# (logo mark, Inter, indigo accent); review and change anything, then load these
# into Railway (backend + worker) or export them before `infra/railway/setup.sh`.
# Lines marked REVIEW need a real-world value only you can supply.

# Name shown in subjects, headers and the "From" display name.
BRAND_NAME=DevHQ

# REVIEW: your registered company name for the email footer (e.g. "DevHQ Ltd").
BRAND_LEGAL_NAME=DevHQ

# Logo lockup (mark + wordmark), PNG for email clients. The frontend serves it from
# Frontend/public/brand/, so on your domain it is https://<domain>/brand/devhq-email-logo.png.
# REVIEW: replace devhq.app with your real domain.
BRAND_LOGO_URL=https://devhq.app/brand/devhq-email-logo.png
BRAND_LOGO_WIDTH=120

# Platform indigo (buttons, top rule) and deep indigo (links, highlights).
BRAND_PRIMARY_COLOR=#4f46e5
BRAND_ACCENT_COLOR=#3730a3

# REVIEW: a monitored mailbox; replies and "contact us" links go here.
BRAND_SUPPORT_EMAIL=support@devhq.app
BRAND_WEBSITE_URL=https://devhq.app

# REVIEW (required before sending at scale): a real postal address you control.
# Left empty on purpose; the footer omits the line until it is set.
BRAND_POSTAL_ADDRESS=

# Sending identity. Send from a dedicated subdomain so marketing or personal mail
# on the root domain never affects transactional reputation.
# REVIEW: replace devhq.app with your real domain, then verify mail.<domain> in Resend.
MAIL_FROM="DevHQ <no-reply@mail.devhq.app>"
MAIL_REPLY_TO=support@devhq.app
APP_URL=https://devhq.app
